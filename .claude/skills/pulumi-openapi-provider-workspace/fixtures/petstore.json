{
  "swagger": "2.0",
  "info": {"title": "Swagger Petstore", "version": "1.0.7"},
  "host": "petstore.swagger.io",
  "basePath": "/v2",
  "schemes": ["https", "http"],
  "tags": [{"name": "pet"}, {"name": "store"}, {"name": "user"}],
  "paths": {
    "/pet": {
      "post": {"tags": ["pet"], "parameters": [{"in": "body", "name": "body", "schema": {"$ref": "#/definitions/Pet"}}], "responses": {"405": {"description": "invalid"}}},
      "put": {"tags": ["pet"], "parameters": [{"in": "body", "name": "body", "schema": {"$ref": "#/definitions/Pet"}}], "responses": {"400": {"description": "bad"}}}
    },
    "/pet/findByStatus": {"get": {"tags": ["pet"], "responses": {"200": {"description": "ok"}}}},
    "/pet/{petId}": {
      "get": {"tags": ["pet"], "parameters": [{"in": "path", "name": "petId", "required": true, "type": "integer"}], "responses": {"200": {"description": "ok", "schema": {"$ref": "#/definitions/Pet"}}}},
      "post": {"tags": ["pet"], "parameters": [{"in": "path", "name": "petId", "required": true, "type": "integer"}], "responses": {"405": {"description": "invalid"}}},
      "delete": {"tags": ["pet"], "parameters": [{"in": "path", "name": "petId", "required": true, "type": "integer"}], "responses": {"400": {"description": "bad"}}}
    },
    "/pet/{petId}/uploadImage": {"post": {"tags": ["pet"], "responses": {"200": {"description": "ok"}}}},
    "/store/inventory": {"get": {"tags": ["store"], "responses": {"200": {"description": "ok"}}}},
    "/store/order": {"post": {"tags": ["store"], "parameters": [{"in": "body", "name": "body", "schema": {"$ref": "#/definitions/Order"}}], "responses": {"200": {"description": "ok", "schema": {"$ref": "#/definitions/Order"}}}}},
    "/store/order/{orderId}": {
      "get": {"tags": ["store"], "parameters": [{"in": "path", "name": "orderId", "required": true, "type": "integer"}], "responses": {"200": {"description": "ok", "schema": {"$ref": "#/definitions/Order"}}}},
      "delete": {"tags": ["store"], "parameters": [{"in": "path", "name": "orderId", "required": true, "type": "integer"}], "responses": {"400": {"description": "bad"}}}
    },
    "/user": {"post": {"tags": ["user"], "parameters": [{"in": "body", "name": "body", "schema": {"$ref": "#/definitions/User"}}], "responses": {"default": {"description": "ok"}}}},
    "/user/createWithList": {"post": {"tags": ["user"], "responses": {"default": {"description": "ok"}}}},
    "/user/login": {"get": {"tags": ["user"], "responses": {"200": {"description": "ok"}}}},
    "/user/{username}": {
      "get": {"tags": ["user"], "parameters": [{"in": "path", "name": "username", "required": true, "type": "string"}], "responses": {"200": {"description": "ok", "schema": {"$ref": "#/definitions/User"}}}},
      "put": {"tags": ["user"], "parameters": [{"in": "path", "name": "username", "required": true, "type": "string"}, {"in": "body", "name": "body", "schema": {"$ref": "#/definitions/User"}}], "responses": {"400": {"description": "bad"}}},
      "delete": {"tags": ["user"], "parameters": [{"in": "path", "name": "username", "required": true, "type": "string"}], "responses": {"400": {"description": "bad"}}}
    }
  },
  "securityDefinitions": {
    "api_key": {"type": "apiKey", "name": "api_key", "in": "header"},
    "petstore_auth": {"type": "oauth2", "flow": "implicit", "authorizationUrl": "https://petstore.swagger.io/oauth/dialog", "scopes": {"write:pets": "modify"}}
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "required": ["name", "photoUrls"],
      "properties": {
        "id": {"type": "integer", "format": "int64"},
        "category": {"$ref": "#/definitions/Category"},
        "name": {"type": "string"},
        "photoUrls": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"$ref": "#/definitions/Tag"}},
        "status": {"type": "string", "description": "pet status", "enum": ["available", "pending", "sold"]}
      }
    },
    "Category": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}},
    "Tag": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}},
    "Order": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "petId": {"type": "integer"},
        "quantity": {"type": "integer"},
        "shipDate": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["placed", "approved", "delivered"]},
        "complete": {"type": "boolean"}
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "username": {"type": "string"},
        "firstName": {"type": "string"},
        "email": {"type": "string"},
        "userStatus": {"type": "integer"}
      }
    }
  }
}
